# Copy to .env and adjust. Never commit the real .env file.

# Comma-separated API keys accepted in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me-to-a-long-random-key

LOG_LEVEL=INFO

# Upstream SOAP service
SOAP_ENDPOINT_URL=http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso
SOAP_TIMEOUT_SECONDS=5
SOAP_MAX_RETRIES=2
SOAP_RETRY_BACKOFF_SECONDS=0.2
