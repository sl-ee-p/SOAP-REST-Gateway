# Copy to .env and adjust. Never commit the real .env file.

# Comma-separated API keys accepted in the X-API-Key header (each at least 16 characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me-to-a-long-random-key

LOG_LEVEL=INFO

# Upstream SOAP service
SOAP_ENDPOINT_URL=http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso
SOAP_TIMEOUT_SECONDS=5
SOAP_MAX_RETRIES=2
SOAP_RETRY_BACKOFF_SECONDS=0.2
# Overall budget for one SOAP call including retries and backoff.
SOAP_TOTAL_TIMEOUT_SECONDS=15
HEALTH_CHECK_TIMEOUT_SECONDS=2
# The readiness probe is public; its result is reused this long so probes can't flood upstream.
HEALTH_CHECK_CACHE_SECONDS=5

# Response cache TTL in seconds (0 disables). Clients can bypass it with `Cache-Control: no-cache`.
CACHE_TTL_SECONDS=300
# How long "not found" answers (unknown country code) are cached; 0 disables.
CACHE_NOT_FOUND_TTL_SECONDS=60
CACHE_MAX_ENTRIES=1024

# Per API key: sustained requests per minute, and the burst size.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
